# ==============================================================================
# B2B Vendor Invoicing & Rental Management Platform - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Credentials (PostgreSQL BaaS)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Fintech Engine & Fee Rules
# Platform convenience fee rate (e.g. 1.5% on transaction base amount)
PLATFORM_FEE_PERCENTAGE=1.5
# Statutory GST rate applicable on Platform Fees (Standard 18% in India)
GST_RATE_PERCENTAGE=18.0

# Risk & Compliance Guardrails
MOCK_MODE=true
BENEFICIARY_COOLING_PERIOD_MINUTES=30
UNVERIFIED_KYC_MAX_TICKET_SIZE=10000.00
MAX_DAILY_TRANSACTION_LIMIT=50000.00

# Payment Gateway & Payout Configuration (Options: 'mock', 'cashfree', 'easebuzz')
GATEWAY_PROVIDER=mock
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

