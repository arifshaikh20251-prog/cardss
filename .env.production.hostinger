# ==============================================================================
# Hostinger Native Node.js Deployment Configuration (Production)
# B2B Vendor Invoicing & Rental Management Platform Backend
# ==============================================================================

# Server Configuration
# Note: Hostinger Phusion Passenger reverse proxy automatically assigns PORT
PORT=5000
NODE_ENV=production

# Supabase Production Database Credentials
# (Paste your live keys from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-production-ref.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# JWT & Auth Security
JWT_SECRET=fintech_production_jwt_secret_replace_in_hostinger_hpanel

# Statutory Fee Rules (SAC 9971)
PLATFORM_FEE_PERCENTAGE=1.5
GST_RATE_PERCENTAGE=18.0

# Risk, Cooling-off & Anti-Self-Transfer Guardrails
MOCK_MODE=true
BENEFICIARY_COOLING_PERIOD_MINUTES=1440
UNVERIFIED_KYC_MAX_TICKET_SIZE=10000.00
MAX_DAILY_TRANSACTION_LIMIT=50000.00

# CORS Allowed Origins (Comma-separated for Vercel Frontend & Custom Domains)
ALLOWED_ORIGINS=https://cardss.vercel.app,https://app.trayago.in,http://localhost:3000

# Payment Gateway Rail
GATEWAY_PROVIDER=mock
CASHFREE_APP_ID=cf_app_production_id
CASHFREE_SECRET_KEY=cf_sec_production_secret
CASHFREE_ENV=production
CASHFREE_API_VERSION=2023-08-01
